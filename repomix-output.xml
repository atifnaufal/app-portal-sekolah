<script>
    function togglePass(id, el) {
        const input = document.getElementById(id);
        if (input.type === 'password') {
            input.type = 'text';
            el.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            input.type = 'password';
            el.classList.replace('bi-eye-slash', 'bi-eye');
        }
    }
</script>
