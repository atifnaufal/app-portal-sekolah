        <p style="color: #64748b; margin-bottom: 24px;">Sistem Sedang Diperiksa...</p>
        
        <div class="spinner"></div>
    </div>

    <script>
        // Cek status aplikasi terlebih dahulu
        async function checkAppStatus() {
            try {
                const response = await fetch('https://app-portal-sekolah-production.up.railway.app/api/status-aplikasi', {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                    }
                });

                if (response.status === 503) {
                    // Mode maintenance
                    showMaintenanceMode();
                    return;
                }

                const data = await response.json();

                if (data.status === 'maintenance') {
                    showMaintenanceMode(data);
                } else {
                    // Mode normal - redirect ke login
                    redirectToApp();
                }
            } catch (error) {
                // Jika gagal konek ke server, tampilkan maintenance offline
                showErrorMode('Tidak bisa terkoneksi ke server. Aplikasi akan cek kembali.');
                setTimeout(redirectToApp, 3000);
            }
        }

        function showMaintenanceMode(data) {
            const container = document.querySelector('.container');
            container.innerHTML = `
                <div class="maintenance-box">
                    <div class="logo">
                        <i class="bi bi-lock me-2"></i>
                    </div>
                    <h3>Sedang Dalam Pengembangan</h3>
                    <p style="color: #64748b; font-size: 14px; margin-bottom: 16px;">${data.message || 'Aplikasi sedang dalam pengembangan.'}</p>
                    <p style="color: #64748b; font-size: 12px; margin-bottom: 16px;">Estimasi rilis: ${data.estimated_release || 'Belum ditetapkan'}</p>
                    <p style="color: #64748b; font-size: 12px;">Aplikasi akan segera kembali dengan fitur baru.</p>
                </div>
            `;
            // Sembunyikan spinner
            const spinner = document.querySelector('.spinner');
            if (spinner) spinner.style.display = 'none';
        }

        function showErrorMode(message) {
            const container = document.querySelector('.container');
            container.innerHTML = `
                <div class="error-box">
                    <i class="bi bi-exclamation-triangle-fill me-2" style="font-size: 24px; color: #dc2626;"></i>
                    <h3>Koneksi Gagal</h3>
                    <p>${message}</p>
                </div>
            `;
        }

        function redirectToApp() {
            window.location.href = 'https://app-portal-sekolah-production.up.railway.app/login';
        }

        // Jalankan cek status saat halaman dimuat
        document.addEventListener('DOMContentLoaded', checkAppStatus);
    </script>
</body>
