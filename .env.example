APP_NAME="App Portal Sekolah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-name.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Railway melayani HTTPS di depan proxy tapi container melihat HTTP polos.
# Tanpa flag ini cookie sesi terbit TANPA atribut Secure sehingga browser
# kadang berhenti mengirimnya -> sesi user_id/user_role "hilang" mendadak.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Kosongkan bila app hanya diakses dari satu host (paling aman untuk Railway).
# Isi hanya bila cookie harus dipakai lintas subdomain.
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database

# Railway / Cloud Specifics
PHP_CLI_SERVER_WORKERS=5
TRUSTED_PROXIES="*"

# =============================================================================
# EMAIL — memakai RESEND lewat SMTP RELAY
# =============================================================================
# Cara ini SENGAJA dipilih karena tidak menambah dependensi composer apa pun.
#
# PENTING: MAIL_MAILER=resend TIDAK AKAN BERHASIL. Transport 'resend' memang
# ada di config/mail.php, tetapi paket 'resend/resend-php' tidak terpasang di
# composer.json, sehingga Laravel melempar error saat email dikirim.
# Gunakan block smtp di bawah ini.
#
# Resend SMTP: host smtp-resend, username HARUS tulisan "resend", password = API key.
#
# Nilai MAIL_SCHEME yang diterima Laravel HANYA "smtp" dan "smtps".
# Jangan tulis "ssl", "tls", atau "smtp+ssl" — Laravel akan menolak dengan
# error: The "smtp+ssl" scheme is not supported.
#
# Railway memblokir port SMTP keluar 25 dan 587 (connection timed out),
# jadi gunakan salah satu dari dua kombinasi yang terbukti jalan ini:
#
#   Brevo SSL     : MAIL_HOST="smtp-relay.brevo.com" MAIL_PORT="465"  MAIL_SCHEME="smtps"
#   Brevo cadangan: MAIL_HOST="smtp-relay.brevo.com" MAIL_PORT="2525" MAIL_SCHEME="smtp"
#
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=email-login-brevo-anda@gmail.com
MAIL_PASSWORD=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxx

# WAJIB: MAIL_FROM_ADDRESS harus merupakan sender yang SUDAH DIVERIFIKASI di
# dashboard Brevo (Settings -> Senders / SMTP & API). Brevo menolak pengiriman
# dari alamat yang belum diverifikasi.
#
# Kelebihan Brevo dibanding Resend: cukup verifikasi SATU alamat email lewat
# link konfirmasi di inbox. Tidak perlu menyentuh DNS sama sekali.
# Verifikasi domain penuh (SPF + DKIM) hanya opsional untuk reputasi lebih baik.
MAIL_FROM_ADDRESS="email-login-brevo-anda@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
