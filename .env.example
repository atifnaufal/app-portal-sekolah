APP_NAME="App Portal Sekolah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-name.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# Railway / Cloud Specifics
PHP_CLI_SERVER_WORKERS=5
TRUSTED_PROXIES="*"

# Pengaturan Email (SMTP) — wajib diisi di produksi agar email verifikasi terkirim.
# Tanpa konfigurasi ini, email hanya dicatat ke log aplikasi dan tidak pernah dikirim.
# Contoh memakai Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SCHEME=tls,
# lalu isi MAIL_USERNAME dengan email Gmail dan MAIL_PASSWORD dengan App Password.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@sekolah.com"
MAIL_FROM_NAME="${APP_NAME}"
