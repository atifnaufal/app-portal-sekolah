APP_NAME="App Portal Sekolah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-name.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

# Railway automatically injects MYSQL_URL (mysql://user:password@host:port/database)
# when a MySQL service is attached. The mysql connection in config/database.php
# parses this DSN, so DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD below are
# optional overrides and can be left blank in Railway.
DB_CONNECTION=mysql
MYSQL_URL="${{MySQL.MYSQL_URL}}"
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# Railway / Cloud Specifics
PHP_CLI_SERVER_WORKERS=5
TRUSTED_PROXIES="*"
