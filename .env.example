APP_NAME="App Portal Sekolah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-name.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
# Railway injects DATABASE_URL automatically when a MySQL service is attached,
# e.g. DATABASE_URL=${{MySQL.MYSQL_URL}}. config/database.php parses this DSN
# and requires it to be present - it will not fall back to localhost.
DATABASE_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# Railway / Cloud Specifics
PHP_CLI_SERVER_WORKERS=5
TRUSTED_PROXIES="*"
