APP_NAME="App Portal Sekolah"
APP_ENV=production
APP_KEY=base64:DvI0YXcStO7jnGi69+KPeeOSNjvDOL5i7974q2nW6bI=
APP_DEBUG=false
APP_URL=https://your-app-name.up.railway.app
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=525600

# Railway melayani HTTPS di depan proxy tapi container melihat HTTP polos.
# Tanpa flag ini cookie sesi terbit TANPA atribut Secure sehingga browser
# kadang berhenti mengirimnya -> sesi user_id/user_role "hilang" mendadak.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Kosongkan bila app hanya diakses dari satu host (paling aman untuk Railway).
# Isi hanya bila cookie harus dipakai lintas subdomain.
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database

# Broadcasting / Reverb (real-time WebSocket)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=0.0.0.0
# Port internal Reverb. Service reverb di Railway expose port ini (pakai 6001).
REVERB_SERVER_PORT=6001
# Port publik yang diakses client via domain service reverb: 443 di Railway.
REVERB_PORT=443
REVERB_SCHEME=https

# ---------------------------------------------------------------------------
# Front-end Reverb (dibake saat `npm run build`)
#
# DI RAILWAY (2 service dalam 1 project — lihat Procfile):
#   - service "web"    -> jalankan app Laravel
#   - service "reverb" -> jalankan `php artisan reverb:start`
#   - service "worker" -> jalankan `php artisan queue:work`
#
# Set env di Railway (di isi ke service BUKAN web, karena dipakai saat build):
#   REVERB_APP_ID / REVERB_APP_KEY / REVERB_APP_SECRET  (sama untuk semua service)
#   REVERB_SERVER_PORT=6001                              (service reverb expose port ini)
#
# Lalu set di Railway agar Vite memakai domain service reverb:
#   VITE_REVERB_APP_KEY=<sama dengan REVERB_APP_KEY>
#   VITE_REVERB_HOST=<domain service reverb>.up.railway.app
#   VITE_REVERB_PORT=443
#   VITE_REVERB_SCHEME=https
#
# DI LOKAL (artisan serve):
#   VITE_REVERB_HOST=localhost
#   VITE_REVERB_PORT=8080
#   VITE_REVERB_SCHEME=http
# ---------------------------------------------------------------------------
VITE_REVERB_APP_KEY=
# VITE_REVERB_HOST=
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https

# Firebase — project data01-c6d26 (Realtime DB + Storage)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=data01-c6d26
FIREBASE_STORAGE_BUCKET=data01-c6d26.appspot.com
FIREBASE_DATABASE_URL=https://data01-c6d26-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS=storage/app/firebase.json
# Railway / Cloud Specifics
PHP_CLI_SERVER_WORKERS=5
TRUSTED_PROXIES="*"

# =============================================================================
# EMAIL — memakai RESEND lewat SMTP RELAY
# =============================================================================
# Cara ini SENGAJA dipilih karena tidak menambah dependensi composer apa pun.
#
# PENTING: MAIL_MAILER=resend TIDAK AKAN BERHASIL. Transport 'resend' memang
# ada di config/mail.php, tetapi paket 'resend/resend-php' tidak terpasang di
# composer.json, sehingga Laravel melempar error saat email dikirim.
# Gunakan block smtp di bawah ini.
#
# Resend SMTP: host smtp-resend, username HARUS tulisan "resend", password = API key.
#
# Nilai MAIL_SCHEME yang diterima Laravel HANYA "smtp" dan "smtps".
# Jangan tulis "ssl", "tls", atau "smtp+ssl" — Laravel akan menolak dengan
# error: The "smtp+ssl" scheme is not supported.
#
# Railway memblokir port SMTP keluar 25 dan 587 (connection timed out),
# jadi gunakan salah satu dari dua kombinasi yang terbukti jalan ini:
#
#   Brevo SSL     : MAIL_HOST="smtp-relay.brevo.com" MAIL_PORT="465"  MAIL_SCHEME="smtps"
#   Brevo cadangan: MAIL_HOST="smtp-relay.brevo.com" MAIL_PORT="2525" MAIL_SCHEME="smtp"
#
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=email-login-brevo-anda@gmail.com
MAIL_PASSWORD=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxx

# WAJIB: MAIL_FROM_ADDRESS harus merupakan sender yang SUDAH DIVERIFIKASI di
# dashboard Brevo (Settings -> Senders / SMTP & API). Brevo menolak pengiriman
# dari alamat yang belum diverifikasi.
#
# Kelebihan Brevo dibanding Resend: cukup verifikasi SATU alamat email lewat
# link konfirmasi di inbox. Tidak perlu menyentuh DNS sama sekali.
# Verifikasi domain penuh (SPF + DKIM) hanya opsional untuk reputasi lebih baik.
MAIL_FROM_ADDRESS="email-login-brevo-anda@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
