APP_NAME="App Portal Sekolah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-name.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Railway melayani HTTPS di depan proxy tapi container melihat HTTP polos.
# Tanpa flag ini cookie sesi terbit TANPA atribut Secure sehingga browser
# kadang berhenti mengirimnya -> sesi user_id/user_role "hilang" mendadak.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Kosongkan bila app hanya diakses dari satu host (paling aman untuk Railway).
# Isi hanya bila cookie harus dipakai lintas subdomain.
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database

# Railway / Cloud Specifics
PHP_CLI_SERVER_WORKERS=5
TRUSTED_PROXIES="*"

# =============================================================================
# EMAIL — memakai RESEND lewat SMTP RELAY
# =============================================================================
# Cara ini SENGAJA dipilih karena tidak menambah dependensi composer apa pun.
#
# PENTING: MAIL_MAILER=resend TIDAK AKAN BERHASIL. Transport 'resend' memang
# ada di config/mail.php, tetapi paket 'resend/resend-php' tidak terpasang di
# composer.json, sehingga Laravel melempar error saat email dikirim.
# Gunakan block smtp di bawah ini.
#
# Resend SMTP: host smtp.resend.com, port 465, scheme ssl,
# username HARUS tulisan "resend", password = API key Anda.
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_SCHEME=ssl
MAIL_USERNAME=resend
MAIL_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_ENCRYPTION=null

# WAJIB: alamat ini HARUS domain yang sudah Anda verifikasi di dashboard Resend
# (Domains → Verify Domain). Kalau memakai domain yang belum diverifikasi,
# Resend menolak pengiriman dengan error 403 "you are not authorized to send
# from this domain" dan email tidak akan pernah sampai.
# Untuk uji coba cepat, Resend menyediakan onboarding@resend.dev, TETAPI hanya
# bisa mengirim ke alamat email akun Resend Anda sendiri.
MAIL_FROM_ADDRESS="noreply@domain-sekolah-anda.sch.id"
MAIL_FROM_NAME="${APP_NAME}"
